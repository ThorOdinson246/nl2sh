# Datasets: nothing under data/ is meant to be tracked (raw scrapes, interim
# processing, processed splits, jsonl dumps, smoke fixtures). A blanket rule
# here means a careless `git add -A` cannot pull any of it in even if a new
# subdirectory shows up that the specific rules below don't yet name.
data/
data/raw/
data/interim/
data/processed/
data/*.jsonl
data/smoke/

# Model weights, in any format we've produced or consumed.
models/
*.gguf
*.safetensors
*.bin
*.pt

# Virtualenvs and Python build/cache noise.
venv/
venv_teacher/
venv_*/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# SLURM / cluster job output.
slurm_outputs/
*.out
*.err

# Local build/runtime products.
runs/
tools/llama.cpp/
runtime/lib/
runtime/raw.txt

# Ollama models, wherever a script happens to materialize them.
ollama_models/
*.ollama/

# Editor / OS cruft.
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Real typed queries -- eval data derived from actual usage. Kept out of git
# per the standing rule on private eval data (can contain hostnames/paths).
data/processed/heldout_user*.jsonl

# scripts/icalfa_feasibility/ is a one-off feasibility spike: a full venv, a
# pixi/podman install, and downloaded ollama models. `venv_*/` above already
# covers venv_icalfa/, but the other two (~950MB combined) were untracked-yet-
# NOT-ignored -- one `git add -A` away from being committed wholesale.
scripts/icalfa_feasibility/ollama_models/
scripts/icalfa_feasibility/podman_pixi/
scripts/icalfa_feasibility/*.log

# Benchmark artifacts: regenerated by every run, and large. Scripts are
# tracked; their outputs are not.
scripts/icalfa_udocker/*.jsonl
scripts/icalfa_udocker/*.log

# LaTeX build artifacts for paper/main.tex. The .tex/.bib/.sty/.bst sources
# are tracked; everything pdflatex/bibtex regenerates is not.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.toc
paper/main.pdf
